{
  "name": "uniblox-store",
  "private": true,
  "version": "1.0.0",
  "description": "Minimal ecommerce store with an nth-order discount system — assessment project",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @uniblox/api dev",
    "dev:web": "pnpm --filter @uniblox/web dev",
    "test": "pnpm --recursive --no-bail test",
    "typecheck": "pnpm --recursive typecheck",
    "build": "pnpm --recursive build"
  }
}
